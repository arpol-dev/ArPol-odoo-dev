<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">     
        <!-- Logo custom retiré : référençait static/img/logo.png, absent du module (404 à chaque impression de ticket) -->
        <xpath expr="//t[@t-if='receipt.company.vat']" position="replace">
            <!-- <t t-if="receipt.company.siret">
                <div>SIRET : <t t-esc="receipt.company.siret" /></div>
            </t> -->
            <div>37A rue de l'église, 25720 Avanne</div>
            <div>SIRET : 98074488200013</div>
            <t t-if="receipt.company.vat">
                <div><t t-esc="receipt.company.vat_label"/> : <t t-esc="receipt.company.vat" /></div>
            </t>
        </xpath>
        <xpath expr="//t[@t-if='receipt.company.email']/div" position="replace">
            <div>contact@casaangels.fr</div>
        </xpath>

        <!-- Supprime les stats de fidélité (points/pétales gagnés, dépensés, solde) -->
        <xpath expr="//t[@t-if='receipt.loyaltyStats']" position="replace"/>

