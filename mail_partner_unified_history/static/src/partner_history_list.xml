<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="mail_partner_unified_history.PartnerHistoryList">
    <div class="o-partner-history-List d-flex flex-column py-2">

        <!-- Loading -->
        <t t-if="!state.isLoaded">
            <div class="text-center p-4 text-muted">
                <i class="fa fa-circle-o-notch fa-spin fa-lg"/>
            </div>
        </t>

        <!-- No messages -->
        <t t-elif="state.messages.length === 0">
            <div class="text-center p-4 text-muted fst-italic small">
                No messages with this partner.
            </div>
        </t>

        <!-- Date-grouped list -->
        <t t-else="">
            <t t-foreach="groupedMessages" t-as="group" t-key="group.dateLabel">
                <!-- Date separator -->
                <div class="d-flex align-items-center gap-2 px-3 py-1">
                    <hr class="flex-grow-1 my-0"/>
                    <span class="small text-muted text-nowrap" t-esc="group.dateLabel"/>
                    <hr class="flex-grow-1 my-0"/>
                </div>

                <!-- Group messages -->
                <t t-foreach="group.messages" t-as="msg" t-key="msg.id">
                    <div class="d-flex gap-2 px-3 py-2 o-partner-history-Message">
                        <!-- Avatar -->
                        <img
                            t-att-src="getAvatarUrl(msg.author_id and msg.author_id[0])"
                            class="rounded-circle flex-shrink-0 mt-1"
                            style="width:32px;height:32px;object-fit:cover;"
                            alt="avatar"
                        />
                        <!-- Content -->
                        <div class="flex-grow-1 overflow-hidden">
                            <!-- Header: author + date + doc badge (outside bubble, like native chatter) -->
                            <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-1 lh-1 mb-1">
                                <div class="d-flex align-items-baseline gap-2 flex-wrap">
                                    <span class="fw-bold small">
                                        <t t-if="msg.author_id">
                                            <a class="o-mail-Message-author text-reset cursor-pointer text-decoration-none"
                                               t-on-click.prevent="() => this.openAuthor(msg)"
                                               t-esc="msg.author_id[1]"/>
                                        </t>
                                        <t t-else="">Unknown</t>
                                    </span>
                                    <span class="text-muted o-xsmaller"
                                          t-esc="getRelativeTime(msg.date)"
                                          t-att-title="formatFullDate(msg.date)"/>
                                    <t t-if="msg.email_status === 'sent'">
                                        <i class="fa fa-envelope-o text-success" style="font-size:0.7rem;" title="Sent"/>
                                    </t>
                                    <t t-elif="msg.email_status === 'exception'">
                                        <i class="fa fa-envelope text-danger" style="font-size:0.7rem;" title="Failed"/>
                                    </t>
                                    <t t-elif="msg.email_status === 'ready'">
                                        <i class="fa fa-envelope-o text-warning" style="font-size:0.7rem;" title="Queued"/>
                                    </t>
                                    <t t-if="msg.is_internal">
                                        <span class="badge bg-warning text-dark"
                                              style="font-size:0.65rem;">Internal note</span>
                                    </t>
                                </div>
                                <!-- Document source badge -->
                                <t t-if="msg.model and msg.res_id">
                                    <button type="button"
                                           class="bg-light border border-primary-subtle text-decoration-none text-nowrap d-flex align-items-center gap-1 rounded"
                                           style="font-size:0.7rem;cursor:pointer;border:none;padding:0.25rem 0.5rem;"
                                           t-on-click="() => this.openDocument(msg)">
                                        <span class="text-primary fw-semibold">↗</span>
                                        <span class="d-flex flex-column align-items-start" style="gap:0.15rem;">
                                            <span class="text-primary fw-semibold lh-sm"><t t-esc="msg.model_description or msg.model"/></span>
                                            <span t-if="msg.record_name" class="text-muted lh-sm" style="font-size:0.65rem;"><t t-esc="msg.record_name"/></span>
                                        </span>
                                    </button>
                                </t>
                            </div>
                            <!-- Content area with bubble (same structure as native chatter) -->
                            <div class="o-mail-Message-contentContainer position-relative d-flex">
                                <div class="o-min-width-0">
                                    <div class="position-relative d-inline-block text-body">
                                        <t t-set="bubbleColor" t-value="getBubbleColor(msg)"/>
                                        <div t-if="bubbleColor"
                                             class="o-mail-Message-bubble rounded-bottom-3 rounded-end-3 position-absolute top-0 start-0 w-100 h-100 border"
                                             t-att-class="{ 'o-blue': bubbleColor === 'blue', 'o-green': bubbleColor === 'green' }"/>
                                        <div class="position-relative text-break o-mail-Message-body mb-0 py-2 align-self-start rounded-end-3 rounded-bottom-3 small"
                                             t-out="getMarkupBody(msg.body)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>

            <!-- Load more button -->
            <div t-if="state.canLoadMore" class="text-center py-2">
                <button class="btn btn-sm btn-link text-muted" t-on-click="() => this.loadMore()">
                    Load more…
                </button>
            </div>
        </t>

    </div>
</t>

</templates>
