<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_mileage_fees" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mileage.fees</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='show_margins']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="standardized_offers_setting">
                    <div class="o_setting_left_pane">
                        <field name="company_mileage_fee_config"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="company_mileage_fee_config"/>
                        <div class="text-muted">
                            Ajouter des frais kilométriques sur les devis et commandes.
                        </div>
                        <div class="content-group" attrs="{'invisible': [('company_mileage_fee_config', '=', False)]}">
                            <div class="mt16">
                                <label for="company_mileage_fee_product" class="o_light_label me-2"/>
                                <field name="company_mileage_fee_product" class="oe_inline"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
