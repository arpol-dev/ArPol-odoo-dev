<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="mail_partner_history.ChatterPatch" t-inherit="mail.Chatter" t-inherit-mode="extension">

    <!-- A. Masquer les activités dans l'onglet historique -->
    <xpath expr="//t[@t-if='props.has_activities and activities.length and !messageSearch.searching and !messageSearch.searched']"
           position="attributes">
        <attribute name="t-if">props.has_activities and activities.length and !messageSearch.searching and !messageSearch.searched and !(state.showHistoryTab and state.activeTab === 'history')</attribute>
    </xpath>

    <!-- B. Onglets : remplacer le div custom par nav-tabs Bootstrap -->
    <xpath expr="//div[hasclass('o-mail-Chatter-content')]" position="before">
        <t t-if="state.showHistoryTab">
            <ul class="nav nav-tabs px-3 justify-content-center">
                <li class="nav-item">
                    <a class="nav-link"
                       t-att-class="{ 'active': state.activeTab === 'discussion' }"
                       href="#" t-on-click.prevent="() => this.switchTab('discussion')">
                        Discussion
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link"
                       t-att-class="{ 'active': state.activeTab === 'history' }"
                       href="#" t-on-click.prevent="() => this.switchTab('history')">
                        Historique <t t-esc="state.historyModelName || 'partenaire'"/>
                    </a>
                </li>
            </ul>
        </t>
    </xpath>

    <!--
        Remplace <Thread t-else=""> par une chaîne t-elif/t-else.
        La chaîne complète après patch :
          SearchMessageResult  t-if="searching"
          PartnerHistoryList   t-elif="showHistoryTab and activeTab === 'history'"
          Thread               t-else=""
    -->
    <xpath expr="//Thread[@t-else]" position="replace">
        <t t-elif="state.showHistoryTab and state.activeTab === 'history'">
            <PartnerHistoryList
                partnerId="state.historyPartnerId"
                partnerName="state.historyPartnerName"
            />
        </t>
        <Thread
            t-else=""
            thread="state.thread"
            t-key="state.thread.localId"
            order="'desc'"
            scrollRef="rootRef"
            jumpPresent="state.jumpThreadPresent"
        />
    </xpath>

</t>

</templates>
