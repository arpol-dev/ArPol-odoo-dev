<?xml version="1.0"?>
<odoo>
    <record id="view_calendar_event_form_teams" model="ir.ui.view">
        <field name="name">calendar.event.form.teams</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='set_discuss_videocall_location']" position="after">
                <button name="set_teams_videocall_location" type="object" class="btn btn-link ps-0" invisible="videocall_location or not user_can_edit" context="{'recurrence_update': recurrence_update}">
                    <span class="fa fa-plus"/><span> Microsoft Teams meeting (if synchronized)</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
