#. module: pos_payment_method_correction
#. odoo-python
#: code:addons/pos_payment_method_correction/models/pos_session.py:0
msgid "A correction cannot change the sign of a payment in %(session)s."
msgstr "Une correction ne peut pas changer le signe d'un paiement de %(session)s."

#. module: pos_payment_method_correction
#: model:ir.model.fields,help:pos_payment_method_correction.field_pos_payment_method_change__cash_impact
msgid ""
"Amount added to the theoretical closing cash of the session, and to the "
"opening and closing cash of the following sessions of the same point of "
"sale."
msgstr ""
"Montant ajouté au fond de caisse théorique de fermeture de la session, et "
"aux fonds d'ouverture et de fermeture des sessions suivantes du même point "
"de vente."

#. module: pos_payment_method_correction
#: model_terms:ir.ui.view,arch_db:pos_payment_method_correction.pos_payment_method_change_view_form
msgid "Apply correction"
msgstr "Appliquer la correction"

#. module: pos_payment_method_correction
#: model:ir.model.fields,field_description:pos_payment_method_correction.field_pos_payment_method_change__available_payment_method_ids
msgid "Available Payment Method"
msgstr "Mode de paiement disponible"

#. module: pos_payment_method_correction
#: model:ir.model.fields,field_description:pos_payment_method_correction.field_pos_payment_method_change__cash_impact
msgid "Change of the cash balance"
msgstr "Variation du fond de caisse"

#. module: pos_payment_method_correction
#: model:ir.model.fields,field_description:pos_payment_method_correction.field_pos_payment_method_change_line__end_after
#: model:ir.model.fields,field_description:pos_payment_method_correction.field_pos_payment_method_change__session_end_after
msgid "Closing cash after"
msgstr "Fond de fermeture après"

#. module: pos_payment_method_correction
#: model:ir.model.fields,field_description:pos_payment_method_correction.field_pos_payment_method_change_line__end_before
#: model:ir.model.fields,field_description:pos_payment_method_correction.field_pos_payment_method_change__session_end_before
msgid "Closing cash before"
msgstr "Fond de fermeture avant"

#. module: pos_payment_method_correction
#: model:ir.actions.server,name:pos_payment_method_correction.action_pos_payment_correct_method
msgid "Correct payment method"
msgstr "Corriger le mode de paiement"

#. module: pos_payment_method_correction
#: model:ir.model,name:pos_payment_method_correction.model_pos_payment_method_change
msgid "Correct the payment method of a POS payment"
msgstr "Corriger le mode de paiement d'un paiement du point de vente"

#. module: pos_payment_method_correction
#: model:ir.model,name:pos_payment_method_correction.model_pos_payment_method_change_line
msgid "Following session cash balances to correct"
msgstr "Fonds de caisse des sessions suivantes à corriger"

#. module: pos_payment_method_correction
#: model:ir.model.fields,field_description:pos_payment_method_correction.field_pos_payment_method_change__line_ids
msgid "Following sessions"
msgstr "Sessions suivantes"

#. module: pos_payment_method_correction
#: model:ir.model.fields,field_description:pos_payment_method_correction.field_pos_payment_method_change__new_payment_method_id
msgid "New payment method"
msgstr "Nouveau mode de paiement"

#. module: pos_payment_method_correction
#: model:ir.model.fields,field_description:pos_payment_method_correction.field_pos_payment_method_change_line__start_after
msgid "Opening cash after"
msgstr "Fond d'ouverture après"

#. module: pos_payment_method_correction
#: model:ir.model.fields,field_description:pos_payment_method_correction.field_pos_payment_method_change_line__start_before
msgid "Opening cash before"
msgstr "Fond d'ouverture avant"

#. module: pos_payment_method_correction
#. odoo-python
#: code:addons/pos_payment_method_correction/models/pos_session.py:0
msgid "No %(method)s amount to remove from %(session)s."
msgstr "Aucun montant %(method)s à retirer de %(session)s."

#. module: pos_payment_method_correction
#. odoo-python
#: code:addons/pos_payment_method_correction/models/pos_session.py:0
msgid "Pay later payments cannot be corrected."
msgstr "Les paiements différés ne peuvent pas être corrigés."

#. module: pos_payment_method_correction
#. odoo-python
#: code:addons/pos_payment_method_correction/models/pos_session.py:0
msgid "Payment method correction is only supported for sessions in company currency."
msgstr ""
"La correction du mode de paiement n'est possible que pour les sessions en "
"devise de la société."

#. module: pos_payment_method_correction
#. odoo-python
#: code:addons/pos_payment_method_correction/models/pos_payment.py:0
msgid "Only the payments of a closed session can be corrected."
msgstr "Seuls les paiements d'une session clôturée peuvent être corrigés."

#. module: pos_payment_method_correction
#. odoo-python
#: code:addons/pos_payment_method_correction/models/pos_session.py:0
msgid "Session %(session)s has no accounting entry."
msgstr "La session %(session)s n'a pas d'écriture comptable."

#. module: pos_payment_method_correction
#. odoo-python
#: code:addons/pos_payment_method_correction/models/pos_session.py:0
msgid ""
"The %(method)s receivable line of %(session)s is not reconciled with a "
"single cash or bank document."
msgstr ""
"La ligne de créance %(method)s de %(session)s n'est pas réconciliée avec un "
"seul document de caisse ou de banque."
