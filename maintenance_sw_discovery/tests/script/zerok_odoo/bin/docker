#!/usr/bin/env bash
# 0k server: Odoo 18 (myc_odoo-v18_1), its Postgres (alias "postgres") and an Apache frontend.
# Frozen answers read from $SCENARIO_DIR/docker; any unexpected call fails loudly.
D="$SCENARIO_DIR/docker"
ODOO=a1b2c3d4e5f6
PG=b2c3d4e5f6a7
fail() { echo "docker stub: unexpected call: docker $*" >&2; exit 1; }
# STUB_DOCKER_ROOT_ONLY=1: the daemon socket needs root (sudo stubs set STUB_AS_ROOT=1)
if [ -n "${STUB_DOCKER_ROOT_ONLY:-}" ] && [ "${STUB_AS_ROOT:-}" != 1 ]; then
  echo "permission denied while trying to connect to the Docker daemon socket" >&2; exit 1
fi

case "$1" in
  version) [ "$*" = "version --format {{.Server.Version}}" ] && { echo 20.10.24; exit 0; }; fail "$@" ;;
  ps) [ "$*" = "ps -q" ] && { printf '%s\n' $ODOO $PG c3d4e5f6a7b8; exit 0; }; fail "$@" ;;
  inspect) [ $# -eq 2 ] && [ -f "$D/inspect-$2.json" ] && { cat "$D/inspect-$2.json"; exit 0; }; fail "$@" ;;
  image)
    h="${3#sha256:}"
    [ "$2" = inspect ] && [ -f "$D/image-${h:0:12}.json" ] && { cat "$D/image-${h:0:12}.json"; exit 0; }
    fail "$@" ;;
  exec) ;;
  *) fail "$@" ;;
esac

shift; c="$1"; shift
if [ "$c" = $ODOO ]; then
  case "$*" in
    "odoo --version") echo "Odoo Server 99.0" ;;   # never called: it would run Odoo code
    "cat /opt/odoo/custom/src/repos.yaml") cat "$D/repos.yaml" ;;
    *)
      [ "$1 $2" = "sh -c" ] || fail exec "$c" "$@"
      tag="$4"; shift 4
      case "$tag" in
        discover-conf)
          # The worst case: the whole file, secrets included (the script keeps 6 keys only).
          [ "$1" = /opt/odoo/auto/odoo.conf ] || fail exec "$c" conf "$@"
          cat "$D/odoo.conf" ;;
        discover-version)
          # release.py of the server sources, read (grep) without running Python
          for f in "$@"; do [ "$f" = /opt/odoo/custom/src/odoo/odoo/release.py ] && {
            echo "version_info = (18, 0, 0, FINAL, 0, '')"; exit 0; }; done
          exit 1 ;;
        discover-addons)
          for d in "$@"; do
            case "$d" in
              /opt/odoo/auto/dev/ArPol-odoo-dev) mods="maintenance_sw_base maintenance_sw_odoo" ;;
              /opt/odoo/auto/addons) mods="base maintenance_sw_base ovh_api sale" ;;
              *) mods="" ;;
            esac
            for m in $mods; do printf '%s\t%s\n' "$d" "$m"; done
          done ;;
        discover-repos)
          printf 'ok\t%s\t%s\t%s\t%s\n' /opt/odoo/custom/src/private-addons \
            "https://deploy:secret123@git.example.com/arpol/private.git" 18.0 \
            0123456789abcdef0123456789abcdef01234567 ;;
        discover-links)
          printf '%s\t%s\n' \
            /opt/odoo/auto/addons/base /opt/odoo/custom/src/odoo/odoo/addons/base \
            /opt/odoo/auto/addons/maintenance_sw_base /opt/odoo/custom/src/ArPol-odoo-dev/maintenance_sw_base \
            /opt/odoo/auto/addons/ovh_api /opt/odoo/auto/dev/ovh_connector/ovh_api \
            /opt/odoo/auto/addons/sale /opt/odoo/custom/src/odoo/addons/sale ;;
        *) fail exec "$c" "$tag" "$@" ;;
      esac ;;
  esac
  exit 0
fi

if [ "$c" = $PG ] && [ "$1" = psql ]; then
  shift
  user="" db="" query=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -U) user="$2"; shift 2 ;;
      -d) db="$2"; shift 2 ;;
      -c) query="$2"; shift 2 ;;
      -X|-w|-At|-A|-t) shift ;;
      *) fail exec "$c" psql "$@" ;;
    esac
  done
  [ "$user" = odoo-v18 ] || { echo "psql: error: FATAL:  role \"$user\" does not exist" >&2; exit 2; }
  case "$db:$query" in
    "postgres:"*pg_database*) printf '%s\n' arpol arpol_test scratch ;;
    "arpol:"*to_regclass*|"arpol_test:"*to_regclass*) echo t ;;
    "scratch:"*to_regclass*) echo f ;;
    "arpol:"*ir_module_module*)
      printf '%s\n' "base|18.0.1.3|installed" "maintenance_sw_base|18.0.1.0.0|to upgrade" \
        "old_module||to remove" "sale|18.0.1.2|installed" ;;
    "arpol_test:"*ir_module_module*)
      printf '%s\n' "base|18.0.1.3|installed" "ovh_api|18.0.1.5.0|installed" ;;
    *) echo "psql: error: unexpected query on $db: $query" >&2; exit 1 ;;
  esac
  exit 0
fi
fail exec "$c" "$@"
