#!/usr/bin/env bash
# User outside the docker group: every call to the daemon is refused.
[ "$1" = --version ] && { echo "Docker version 24.0.7, build afdd53b"; exit 0; }
echo "permission denied while trying to connect to the Docker daemon socket at unix:///var/run/docker.sock: Get \"http://%2Fvar%2Frun%2Fdocker.sock/v1.24/containers/json\": dial unix /var/run/docker.sock: connect: permission denied" >&2
exit 1
