#!/usr/bin/env bash
# Secrets everywhere (markers LEAKnn, none may reach the output): an Odoo container configured
# by its command line (-c, --db_host, -r), a Redis with --requirepass and a Postgres "pgx".
D="$SCENARIO_DIR/docker"
ODOO=0d0000000001
REDIS=0d0000000002
PG=0d0000000003
fail() { echo "docker stub: unexpected call: docker $*" >&2; exit 1; }

case "$1" in
  version) [ "$*" = "version --format {{.Server.Version}}" ] && { echo 26.1.0; exit 0; }; fail "$@" ;;
  ps) [ "$*" = "ps -q" ] && { printf '%s\n' $ODOO $REDIS $PG; exit 0; }; fail "$@" ;;
  inspect) [ $# -eq 2 ] && [ -f "$D/inspect-$2.json" ] && { cat "$D/inspect-$2.json"; exit 0; }; fail "$@" ;;
  image)
    h="${3#sha256:}"
    [ "$2" = inspect ] && [ -f "$D/image-${h:0:12}.json" ] && { cat "$D/image-${h:0:12}.json"; exit 0; }
    fail "$@" ;;
  exec) ;;
  *) fail "$@" ;;
esac

shift; c="$1"; shift
if [ "$c" = $ODOO ]; then
  case "$*" in
    "odoo --version") echo "Odoo Server 99.0" ;;   # never called: it would run Odoo code
    "cat /opt/odoo/custom/src/repos.yaml") cat "$D/repos.yaml" ;;
    *)
      [ "$1 $2" = "sh -c" ] || fail exec "$c" "$@"
      tag="$4"; shift 4
      case "$tag" in
        discover-conf)
          # -c from the command line comes first
          [ "$1" = /srv/conf/odoo.conf ] || fail exec "$c" conf "$@"
          cat "$D/odoo.conf" ;;
        discover-version)
          # found next to the addons_path directory .../odoo/addons; saas tuple, compact syntax
          for f in "$@"; do [ "$f" = /mnt/b/../release.py ] && {
            echo "version_info=('saas~17',2,0,FINAL,0,'')"; exit 0; }; done
          exit 1 ;;
        discover-addons)
          # addons_path deduplicated: /mnt/a once
          [ "$*" = "/mnt/a /mnt/b" ] || fail exec "$c" addons "$@"
          printf '%s\t%s\n' /mnt/a mod_a /mnt/b mod_b ;;
        discover-repos)
          printf 'ok\t%s\t%s\t%s\t%s\n' /mnt/a "https://u:pa/LEAK21@git.example.com/r.git" 17.0 \
            abcdefabcdefabcdefabcdefabcdefabcdefabcd ;;
        discover-links) ;;
        *) fail exec "$c" "$tag" "$@" ;;
      esac ;;
  esac
  exit 0
fi

if [ "$c" = $PG ] && [ "$1" = psql ]; then
  shift
  user="" db="" query=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -U) user="$2"; shift 2 ;;
      -d) db="$2"; shift 2 ;;
      -c) query="$2"; shift 2 ;;
      -X|-w|-At|-A|-t) shift ;;
      *) fail exec "$c" psql "$@" ;;
    esac
  done
  # user from -r on the command line (not db_user of odoo.conf)
  [ "$user" = leakuser ] || { echo "psql: error: FATAL:  role \"$user\" does not exist" >&2; exit 2; }
  case "$db:$query" in
    "postgres:"*pg_database*) printf '%s\n' brokendb flakydb leakdb ;;
    # one database unreadable at each step: reported in error, not left out
    "brokendb:"*to_regclass*) echo "psql: error: FATAL:  permission denied for database" >&2; exit 2 ;;
    "flakydb:"*to_regclass*) echo t ;;
    "flakydb:"*ir_module_module*) echo "psql: error: canceling statement" >&2; exit 1 ;;
    "leakdb:"*to_regclass*) echo t ;;
    "leakdb:"*ir_module_module*) echo "base|17.0.1.3|installed" ;;
    *) echo "psql: error: unexpected query on $db: $query" >&2; exit 1 ;;
  esac
  exit 0
fi
fail exec "$c" "$@"
