<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_appointment_type_form_inherit_customvideolocation" model="ir.ui.view">
        <field name="name">view.appointment.type.form.inherit.customvideolocation</field>
        <field name="model">appointment.type</field>
        <field name="inherit_id" ref="appointment.appointment_type_view_form"/>
        <field name="priority" eval="16"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='event_videocall_source']" position="after">
                <field name="custom_videocall_location" invisible="event_videocall_source != 'custom'"/>
            </xpath>
        </field>
    </record>
</odoo>