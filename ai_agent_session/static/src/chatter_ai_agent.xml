<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Bouton à côté de "Activities", affiché sur TOUS les chatters (pas seulement ceux des
         modèles avec activités). Même grisage que les autres boutons de la barre. -->
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-activity')]" position="after">
            <button class="o-mail-Chatter-aiAgent btn btn-secondary text-nowrap ms-1"
                    t-att-class="{ 'my-2': !props.compactHeight }"
                    t-att-disabled="!state.thread.canPostMessage and props.threadId"
                    t-on-click="launchAiAgent">
                <span>AI Agent</span>
            </button>
        </xpath>
    </t>
</templates>
