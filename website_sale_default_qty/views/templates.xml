<odoo>

    <template id="product_quantity_default_qty" inherit_id="website_sale.product_quantity"
              name="Default Cart Quantity">
        <xpath expr="//input[@name='add_qty']" position="attributes">
            <attribute name="t-att-value">product_variant.website_default_qty or 1</attribute>
        </xpath>
    </template>

</odoo>
