<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_equipment_view_form" model="ir.ui.view">
        <field name="name">equipment.form.odoo</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance_sw_base.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_odoo_databases" type="object"
                        class="oe_stat_button" icon="fa-database"
                        invisible="not odoo_database_count">
                    <field name="odoo_database_count" widget="statinfo" string="Odoo Databases"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
