<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maintenance_odoo_module_view_list" model="ir.ui.view">
        <field name="name">maintenance.odoo.module.list</field>
        <field name="model">maintenance.odoo.module</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="database_id"/>
                <field name="installed_version"/>
                <field name="state"/>
                <field name="component_id"/>
                <field name="repository_id"/>
            </list>
        </field>
    </record>

    <record id="maintenance_odoo_module_view_form" model="ir.ui.view">
        <field name="name">maintenance.odoo.module.form</field>
        <field name="model">maintenance.odoo.module</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="database_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="installed_version"/>
                            <field name="state"/>
                            <field name="component_id"/>
                            <field name="repository_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="maintenance_odoo_module_view_search" model="ir.ui.view">
        <field name="name">maintenance.odoo.module.search</field>
        <field name="model">maintenance.odoo.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="database_id"/>
                <field name="repository_id"/>
                <filter string="Installed" name="installed" domain="[('state', '=', 'installed')]"/>
                <filter string="To Upgrade" name="to_upgrade" domain="[('state', '=', 'to_upgrade')]"/>
                <filter string="To Remove" name="to_remove" domain="[('state', '=', 'to_remove')]"/>
                <group expand="0" string="Group By">
                    <filter string="Database" name="group_database" context="{'group_by': 'database_id'}"/>
                    <filter string="Repository" name="group_repository" context="{'group_by': 'repository_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="maintenance_odoo_module_action" model="ir.actions.act_window">
        <field name="name">Odoo Modules</field>
        <field name="res_model">maintenance.odoo.module</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
