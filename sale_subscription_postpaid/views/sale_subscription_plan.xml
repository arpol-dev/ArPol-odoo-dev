<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_subscription_plan_view_form_postpaid_invoicing" model="ir.ui.view">
        <field name="name">sale.subscription.order.form.postpaid.invoicing</field>
        <field name="model">sale.subscription.plan</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_plan_view_form"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='billing_first_day']" position="before">
                <field name="subscription_invoice_policy"/>
            </xpath>
        </field>
    </record>
    <record id="sale_subscription_plan_view_tree_postpaid_invoicing" model="ir.ui.view">
        <field name="name">sale.subscription.order.tree.postpaid.invoicing</field>
        <field name="model">sale.subscription.plan</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_plan_view_tree"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='billing_period_display']" position="after">
                <field name="subscription_invoice_policy" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
