<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Le bouton "Activities" du chatter ouvre ce wizard (mail.activity.schedule), pas
         directement le formulaire mail.activity — voir models/mail_activity_schedule.py.
         activity_category (related='activity_type_id.category') est un champ core déjà chargé
         invisible dans la vue de base : pas besoin de le rajouter ici. -->
    <record id="mail_activity_schedule_view_form_ai_agent" model="ir.ui.view">
        <field name="name">mail.activity.schedule.view.form.ai.agent</field>
        <field name="model">mail.activity.schedule</field>
        <field name="inherit_id" ref="mail.mail_activity_schedule_view_form"/>
        <field name="arch" type="xml">
            <field name="note" position="before">
                <group invisible="activity_category != 'ai_agent'" string="AI Agent">
                    <field name="ai_model"/>
                    <field name="ai_permission_mode"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="activity_category != 'ai_agent'">
                    The description below is the main request sent to the agent. It also
                    receives the full record data, the chatter history, and can freely explore
                    the database if it has its own access. Model and permission mode default from
                    the activity type — adjust them above for this session only if needed.
                </div>
            </field>
        </field>
    </record>
</odoo>
